{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "" },
  "Auth": { "PublicBaseUrl": "http://localhost:4200", "TokenMinutes": 15, "MaxLinksPerEmailPer15Min": 3, "AdminEmails": [] },
  "Email": { "Mode": "smtp", "From": "no-reply@example.test" },
  "Database": { "MigrateOnStartup": false },
  "Content": { "Directory": "", "BootstrapOnStartup": false },
  "RateLimits": { "AuthPerMinute": 10 },
  "Workers": { "Expiry": true }
}
