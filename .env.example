# Copy to .env for docker compose. Never commit .env.
POSTGRES_PASSWORD=change-me-local-only
ADMIN_EMAIL=admin@example.test
MAIL_FROM=no-reply@example.test

# Production settings are passed as environment variables by your host (names use __ for sections):
# ConnectionStrings__Default=Host=...;Database=...;Username=...;Password=...   (secret)
# Auth__PublicBaseUrl=https://your-domain
# Auth__AdminEmails__0=you@example.com
# Email__Mode=smtp
# Email__From=no-reply@your-domain
# Email__SmtpHost=smtp.your-provider.example
# Email__SmtpPort=587
# Email__SmtpUser=...        (secret)
# Email__SmtpPassword=...    (secret)
# DataProtection__KeysPath=/keys   (persistent volume)
